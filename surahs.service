[Unit]
Description=Quran Surahs Chromecast Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USERNAME
WorkingDirectory=/home/YOUR_USERNAME/git/surahs-chromecast
ExecStart=/home/YOUR_USERNAME/git/surahs-chromecast/venv/bin/python3 surahs.py
Restart=always
RestartSec=10
StandardOutput=append:/var/log/surahs_chromecast.log
StandardError=append:/var/log/surahs_chromecast.log

[Install]
WantedBy=multi-user.target
